; Standalone Soulslike project. No legacy game content is referenced.
config_version=5
[application]
config/name="Ashen Oath"
run/main_scene="res://scenes/locations/ashen_outskirts.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="An original dark fantasy action RPG prototype."
[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.032, 0.045, 1)
[autoload]
RunState="*res://scripts/core/run_state.gd"
InputSetup="*res://scripts/core/input_setup.gd"
