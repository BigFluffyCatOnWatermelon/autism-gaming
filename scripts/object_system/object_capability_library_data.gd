static func _append_category(
	output: Array[ObjectCapabilityDefinition],
	category_id: String,
	category_name: String,
	category_hint: String,
	rows: Array
) -> void:
	for row in rows:
		var definition := ObjectCapabilityDefinition.new()
		definition.capability_id = str(row[0])
		definition.display_name = str(row[1])
		definition.description = str(row[2])
		definition.keywords = PackedStringArray([
			definition.capability_id.replace("_", " "),
			definition.display_name,
			category_name
		])
		definition.icon = "sparkles"
		definition.category_id = category_id
		definition.category_name = category_name
		definition.runtime_status = "Planned"
		definition.implementation_note = category_hint + " Runtime-поведение ещё не реализовано."
		definition.available_in_simple_mode = true
		definition.display_order = output.size() + 100
		definition.icon_atlas_index = output.size()
		output.append(definition)


